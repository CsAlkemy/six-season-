# Vercel Blob: created automatically when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Admin login (/admin). Use a long password.
ADMIN_PASSWORD=
# Signs the admin and customer login cookies. Any random 32+ character string: `openssl rand -hex 32`
ADMIN_SECRET=

# Optional, off by default. SMS codes via BulkSMSBD (bulksmsbd.net). Leave both empty and no SMS is ever sent:
# guests check out without a code, accounts log in by password, and buyers find an order by its number and mobile.
# Fill both in to bring codes back at checkout, code login and signup.
SMS_API_KEY=
SMS_SENDER_ID=

# Optional. The store's address for canonical links, the sitemap and share images; defaults to https://www.matirtaan.com.bd
SITE_URL=
# Optional. Only the content="…" value of the meta tag Google Search Console / Bing Webmaster Tools give you.
# Not needed if the site is verified by a DNS record instead.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Optional. Google Analytics 4 Measurement ID (G-XXXXXXXXXX) and the Meta (Facebook) Pixel ID (digits only).
# Nothing loads or is sent until they're set; add them in Vercel and redeploy.
GA_MEASUREMENT_ID=
META_PIXEL_ID=
