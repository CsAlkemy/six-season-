# Vercel Blob: created automatically when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Admin login (/admin). Use a long password.
ADMIN_PASSWORD=
# Signs the admin and customer login cookies. Any random 32+ character string: `openssl rand -hex 32`
ADMIN_SECRET=

# OTP SMS via BulkSMSBD (bulksmsbd.net). Without these, development prints codes to the terminal
# and production can't send them, so guests can't check out.
SMS_API_KEY=
SMS_SENDER_ID=

# Demo only: a 6-digit code that verifies any number, with no SMS sent. Leave empty on a live store,
# because anyone who knows it can sign in as any customer.
DEMO_OTP=

# Optional. The store's address for canonical links, the sitemap and share images; defaults to https://www.matirtaan.com.bd
SITE_URL=
# Optional. Only the content="…" value of the meta tag Google Search Console / Bing Webmaster Tools give you.
# Not needed if the site is verified by a DNS record instead.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
